<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.econovafx.modules.accounting.controller.TransactionsController"
      spacing="20">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="page-header">
        <FontIcon iconLiteral="mdi2r-receipt-outline" iconSize="22" styleClass="icon-brand-ink"/>
        <Label text="Transacciones" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <DatePicker fx:id="fromDatePicker" promptText="Desde" styleClass="rounded-md"/>
        <DatePicker fx:id="toDatePicker" promptText="Hasta" styleClass="rounded-md"/>
        <Button text="Filtrar" onAction="#filterTransactions" styleClass="btn, btn-info"/>
        <Button text="Nueva Transacción" onAction="#newTransaction" styleClass="btn, btn-success"/>
    </HBox>

    <!-- Transactions Table -->
    <VBox VBox.vgrow="ALWAYS" spacing="10">
        <TableView fx:id="transactionsTable" VBox.vgrow="ALWAYS" styleClass="rounded-lg, border, border-gray-200">
            <columns>
                <TableColumn fx:id="colDate" text="Fecha" prefWidth="100"/>
                <TableColumn fx:id="colNumber" text="Número" prefWidth="120"/>
                <TableColumn fx:id="colType" text="Tipo" prefWidth="100"/>
                <TableColumn fx:id="colDescription" text="Descripción" prefWidth="250"/>
                <TableColumn fx:id="colReference" text="Referencia" prefWidth="120"/>
                <TableColumn fx:id="colDebit" text="Total Débito" prefWidth="120"/>
                <TableColumn fx:id="colCredit" text="Total Crédito" prefWidth="120"/>
                <TableColumn fx:id="colStatus" text="Estado" prefWidth="100"/>
            </columns>
        </TableView>

        <!-- Action Buttons -->
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Ver Detalles" onAction="#viewTransactionDetails" styleClass="btn, btn-info"/>
            <Button text="Publicar" onAction="#postTransaction" styleClass="btn, btn-success"/>
            <Button text="Reversar" onAction="#reverseTransaction" styleClass="btn, btn-warning"/>
            <Button text="Eliminar" onAction="#deleteTransaction" styleClass="btn, btn-danger"/>
        </HBox>
    </VBox>

</VBox>
