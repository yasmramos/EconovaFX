<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox fx:id="companySelectionRoot" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="450.0" prefWidth="500.0"
      styleClass="selection-dialog-container"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.econovafx.modules.core.ui.controller.CompanySelectionController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <!-- Header Section -->
    <VBox alignment="CENTER" spacing="10.0" VBox.vgrow="NEVER">
        <Label text="🏢" textAlignment="CENTER">
            <font>
                <Font size="42.0"/>
            </font>
        </Label>
        <Label text="Select Company" styleClass="selection-dialog-title">
            <font>
                <Font name="System Bold" size="24.0"/>
            </font>
        </Label>
        <Label text="Choose the company you want to work with" styleClass="selection-dialog-subtitle" wrapText="true">
            <font>
                <Font size="13.0"/>
            </font>
        </Label>
    </VBox>

    <Region prefHeight="25.0" VBox.vgrow="NEVER"/>

    <!-- Company List Card -->
    <VBox alignment="CENTER" spacing="15.0" styleClass="selection-dialog-card" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
        </padding>

        <!-- Progress indicator while loading -->
        <ProgressBar fx:id="progressBar" prefWidth="300.0" visible="false" managed="false"/>

        <!-- Error message -->
        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" visible="false" managed="false" 
               textFill="#e74c3c"/>

        <!-- Empty state message -->
        <Label fx:id="emptyStateLabel" styleClass="empty-state-label" wrapText="true" visible="false" managed="false"
               text="No companies found. Please contact your administrator."/>

        <!-- Company ListView -->
        <ListView fx:id="companyListView" prefHeight="250.0" styleClass="company-list-view"/>

        <!-- Selected company info -->
        <VBox fx:id="selectedCompanyInfo" spacing="5.0" styleClass="selected-info-box" visible="false" managed="false">
            <Label text="Selected:" styleClass="info-label"/>
            <Label fx:id="selectedCompanyLabel" styleClass="selected-company-name" wrapText="true"/>
        </VBox>
    </VBox>

    <Region prefHeight="20.0" VBox.vgrow="NEVER"/>

    <!-- Action Buttons -->
    <HBox alignment="CENTER" spacing="15.0" VBox.vgrow="NEVER">
        <Button fx:id="cancelButton" onAction="#handleCancel" prefHeight="40.0" prefWidth="120.0"
                text="Cancel" styleClass="cancel-button"/>
        <Button fx:id="selectButton" onAction="#handleSelect" prefHeight="40.0" prefWidth="150.0"
                text="Select Company" styleClass="select-button" disable="true"/>
    </HBox>

    <Region prefHeight="10.0" VBox.vgrow="NEVER"/>

    <!-- Footer -->
    <Label text="Multi-tenant system - Company level selection" styleClass="selection-dialog-footer"/>
</VBox>
