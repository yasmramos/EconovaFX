<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.econovafx.modules.accounting.controller.AccountClassController"
      fx:id="contentArea"
      spacing="20"
      styleClass="bg-gray-50, p-6">

    <Label text="Account Classification" styleClass="text-2xl, font-bold, text-slate-800"><graphic><FontIcon iconLiteral="mdi2t-tree-outline" iconSize="24"/></graphic></Label>

    <Separator/>

    <!-- Toolbar -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="btnNuevo" graphicTextGap="8" onAction="#handleNuevo" styleClass="btn, btn-primary">
            <text>New Classification</text>
            <graphic><FontIcon iconLiteral="mdi2p-plus-circle" iconSize="18"/></graphic>
        </Button>
        <Button fx:id="btnEditar" graphicTextGap="8" onAction="#handleEditar" styleClass="btn, btn-secondary">
            <text>Edit</text>
            <graphic><FontIcon iconLiteral="mdi2p-pencil" iconSize="18"/></graphic>
        </Button>
        <Button fx:id="btnEliminar" graphicTextGap="8" onAction="#handleEliminar" styleClass="btn, btn-danger">
            <text>Delete</text>
            <graphic><FontIcon iconLiteral="mdi2d-delete-outline" iconSize="18"/></graphic>
        </Button>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="txtBuscar" prefWidth="250" promptText="Search classifications..."/>
    </HBox>

    <!-- Classifications Tree Table -->
    <VBox styleClass="card, bg-white, p-6" spacing="15" VBox.vgrow="ALWAYS">
        <Label text="Account Classifications Hierarchy" styleClass="text-lg, font-semibold, text-slate-700"/>

        <TreeView fx:id="classTree" prefHeight="400">
            <root>
                <TreeItem value="Root">
                    <children>
                        <TreeItem value="Assets"/>
                        <TreeItem value="Liabilities"/>
                        <TreeItem value="Equity"/>
                        <TreeItem value="Revenue"/>
                        <TreeItem value="Expenses"/>
                    </children>
                </TreeItem>
            </root>
        </TreeView>
    </VBox>

    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>
</VBox>
