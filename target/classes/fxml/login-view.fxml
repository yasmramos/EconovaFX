<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox fx:id="loginRoot" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
      prefHeight="550.0" prefWidth="420.0" 
      styleClass="login-container" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.econovafx.modules.security.ui.controller.LoginController">
    
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>
    
    <!-- Title Bar with Close Button -->
    <HBox alignment="CENTER_RIGHT" spacing="10.0" VBox.vgrow="NEVER">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="closeButton" onAction="#handleClose" text="%login.close" styleClass="close-button"/>
    </HBox>
    
    <!-- Logo/Title Section -->
    <VBox alignment="CENTER" spacing="15.0" VBox.vgrow="NEVER">
        <ImageView fx:id="logoImage" fitHeight="80.0" fitWidth="80.0" preserveRatio="true">
            <image>
                <javafx.scene.image.Image url="@../images/logo.svg"/>
            </image>
        </ImageView>
        <Label text="%login.title" styleClass="login-title">
            <font>
                <Font name="System Bold" size="28.0"/>
            </font>
        </Label>
        <Label text="%login.subtitle" styleClass="login-subtitle">
            <font>
                <Font size="14.0"/>
            </font>
        </Label>
    </VBox>
    
    <Region prefHeight="25.0" VBox.vgrow="NEVER"/>
    
    <!-- Login Form Card -->
    <VBox alignment="CENTER" spacing="20.0" styleClass="login-card" VBox.vgrow="NEVER">
        <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
        </padding>
        
        <!-- Username Field -->
        <VBox spacing="5.0" styleClass="input-group">
            <Label text="%login.username" styleClass="input-label"/>
            <TextField fx:id="usernameField" promptText="%login.username.prompt" styleClass="text-field"/>
        </VBox>
        
        <!-- Password Field -->
        <VBox spacing="5.0" styleClass="input-group">
            <Label text="%login.password" styleClass="input-label"/>
            <PasswordField fx:id="passwordField" promptText="%login.password.prompt" styleClass="password-field"/>
        </VBox>
        
        <!-- Error Message -->
        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" visible="false" managed="false"/>
        
        <!-- Progress Bar -->
        <ProgressBar fx:id="progressBar" prefWidth="200.0" visible="false" managed="false"/>
        
        <!-- Login Button -->
        <Button fx:id="loginButton" onAction="#handleLogin" prefHeight="45.0" prefWidth="200.0" 
                text="%login.button" styleClass="login-button"/>
    </VBox>
    
    <Region prefHeight="20.0" VBox.vgrow="NEVER"/>
    
    <!-- Footer -->
    <Label text="%login.footer" styleClass="login-footer"/>
</VBox>
