<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.econovafx.modules.core.ui.controller.ProfileController"
      fx:id="contentArea"
      spacing="20"
      styleClass="bg-gray-50, p-6">

    <Label text="My Profile" styleClass="text-2xl, font-bold, text-slate-800"><graphic><FontIcon iconLiteral="mdi2a-account-circle" iconSize="24"/></graphic></Label>

    <Separator/>

    <!-- Profile Card -->
    <VBox styleClass="card, bg-white, p-6" spacing="20" alignment="CENTER">
        <StackPane>
            <FontIcon iconLiteral="mdi2a-account-circle" iconSize="80" styleClass="text-gray-300"/>
        </StackPane>
        
        <VBox spacing="10" alignment="CENTER">
            <Label fx:id="lblUserName" text="Administrator" styleClass="text-xl, font-semibold, text-slate-800"/>
            <Label fx:id="lblUserEmail" text="admin@econovafx.com" styleClass="text-sm, text-slate-500"/>
            <Label fx:id="lblUserRole" text="System Administrator" styleClass="text-xs, text-slate-400"/>
        </VBox>
        
        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="btnEditProfile" onAction="#handleEditProfile" styleClass="btn, btn-primary">
                <text>Edit Profile</text>
                <graphic><FontIcon iconLiteral="mdi2p-pencil" iconSize="16"/></graphic>
            </Button>
            <Button fx:id="btnChangePassword" onAction="#handleChangePassword" styleClass="btn, btn-secondary">
                <text>Change Password</text>
                <graphic><FontIcon iconLiteral="mdi2k-key" iconSize="16"/></graphic>
            </Button>
        </HBox>
    </VBox>

    <!-- User Information -->
    <VBox styleClass="card, bg-white, p-6" spacing="15">
        <Label text="User Information" styleClass="text-lg, font-semibold, text-slate-700"/>
        
        <GridPane hgap="20" vgap="15">
            <columnConstraints>
                <ColumnConstraints percentWidth="30"/>
                <ColumnConstraints percentWidth="70"/>
            </columnConstraints>
            
            <Label text="Full Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="text-slate-600"/>
            <Label fx:id="lblFullName" text="System Administrator" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="text-slate-800"/>
            
            <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="text-slate-600"/>
            <Label fx:id="lblEmail" text="admin@econovafx.com" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="text-slate-800"/>
            
            <Label text="Role:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="text-slate-600"/>
            <Label fx:id="lblRole" text="Administrator" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="text-slate-800"/>
            
            <Label text="Department:" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="text-slate-600"/>
            <Label fx:id="lblDepartment" text="IT Department" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="text-slate-800"/>
            
            <Label text="Last Login:" GridPane.columnIndex="0" GridPane.rowIndex="4" styleClass="text-slate-600"/>
            <Label fx:id="lblLastLogin" text="N/A" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="text-slate-800"/>
        </GridPane>
    </VBox>

    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>
</VBox>
