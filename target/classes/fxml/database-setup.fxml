<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="root" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.econovafx.modules.core.ui.controller.DatabaseSetupController" spacing="18" alignment="TOP_CENTER" stylesheets="/css/theme-tokens.css,/css/dialog-styles.css,/css/database-setup.css" styleClass="database-setup-dialog">
    <padding>
        <Insets top="18" right="22" bottom="20" left="22" />
    </padding>

    <VBox spacing="4" alignment="CENTER" styleClass="db-header-panel">
        <Label text="Configuración de la base de datos" styleClass="db-dialog-title" />
        <Label text="Selecciona el tipo de conexión y completa los datos del motor de datos" styleClass="db-dialog-subtitle" />
    </VBox>

    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="db-type-row">
        <Label text="Tipo de base de datos" styleClass="field-label" />
        <ComboBox fx:id="dbTypeCombo" prefWidth="180" styleClass="db-field" />
    </HBox>

    <GridPane hgap="12" vgap="10" styleClass="db-form-panel">
        <columnConstraints>
            <ColumnConstraints minWidth="120" halignment="RIGHT" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="260" />
        </columnConstraints>

        <Label text="Host" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label" />
        <TextField fx:id="pgHostField" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="db-field" />

        <Label text="Puerto" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label" />
        <TextField fx:id="pgPortField" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="db-field" />

        <Label text="Base de datos" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label" />
        <TextField fx:id="pgDatabaseField" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="db-field" />

        <Label text="Usuario" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="field-label" />
        <TextField fx:id="pgUserField" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="db-field" />

        <Label text="Contraseña" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="field-label" />
        <PasswordField fx:id="pgPasswordField" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="db-field" />

        <Label text="SSL mode" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="field-label" />
        <ComboBox fx:id="pgSslModeCombo" GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="260" styleClass="db-field" />
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="db-actions">
        <Button fx:id="testButton" text="Probar conexión" styleClass="modern-button,button-secondary" />
        <Button fx:id="saveButton" text="Guardar y continuar" styleClass="modern-button,button-primary" />
        <Button fx:id="cancelButton" text="Cancelar" styleClass="modern-button,button-secondary" />
    </HBox>

    <Label fx:id="statusLabel" text="" wrapText="true" styleClass="db-status-label" />
</VBox>
