#!/usr/bin/env bash
# Enforce Conventional Commits format on commit messages.
# See CONTRIBUTING.md for the full policy.

MSG_FILE="$1"
# First non-comment, non-empty line is the subject
SUBJECT=$(grep -v '^#' "$MSG_FILE" | sed '/^$/d' | head -n 1)

PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9\-_.]+\))?!?: [a-z0-9].*'

if [[ "$SUBJECT" =~ ^Merge\  || "$SUBJECT" =~ ^Revert\  ]]; then
  exit 0
fi

if ! echo "$SUBJECT" | grep -qE "$PATTERN"; then
  echo "ERROR: Commit message does not follow Conventional Commits." >&2
  echo "" >&2
  echo "  Found:    $SUBJECT" >&2
  echo "  Expected: <type>[optional scope]: <description>  (in English)" >&2
  echo "  Types:    feat fix docs style refactor perf test build ci chore revert" >&2
  echo "  Example:  feat(billing): add sequential invoice numbering" >&2
  echo "" >&2
  echo "See CONTRIBUTING.md for details." >&2
  exit 1
fi

exit 0
