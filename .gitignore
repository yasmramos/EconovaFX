```gitignore
# Compiled and build artifacts
*.class
*.o
*.obj
*.out
build/
target/

# Dependencies
lib_managed/
project/target/
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
**/.mypy_cache/
**/.pytest_cache/
**/.gradle/
**/vendor/bundle/
**/vendor/ruby/

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# Environment
.env
.env.local
.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```